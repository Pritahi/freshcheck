# Demo mode (default true) runs the full UI on canned fixtures with zero keys.
DEMO_MODE=true

# Live mode: self-hosted Bifrost gateway (OpenAI-compatible endpoint).
BIFROST_URL=http://localhost:8080/v1
BIFROST_MODEL=groq/llama-3.3-70b-versatile
# Optional bearer token, only when BIFROST_URL is a hosted OpenAI-compatible
# endpoint that needs auth (e.g. Groq on serverless deploys). Local Bifrost: leave empty.
BIFROST_API_KEY=

# Live mode: Tavily Search API key (free credits cover this).
TAVILY_API_KEY=

# Provider keys live in the Bifrost gateway config, not in this app.
# GROQ_API_KEY=   (free tier, referenced by bifrost.config.json)
# GEMINI_API_KEY= (free tier, referenced by bifrost.config.json)
